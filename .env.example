# Supabase project settings (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only. Never expose to the client or commit to git.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Anthropic Claude API. Server-only. Never expose to the client or commit to git.
ANTHROPIC_API_KEY=your-anthropic-api-key
ANTHROPIC_MODEL=claude-sonnet-5-20251001

# Used to build the email-confirmation redirect link during signup.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Required to sign up at all. Server-only — never expose to the client or
# commit to git. Share this out-of-band (not in the app) with people you
# want to be able to request access.
SIGNUP_INVITE_CODE=change-me-to-a-long-random-string

# Airbnb "Export Calendar" iCal URL (Airbnb host dashboard -> Calendar ->
# Availability -> Export Calendar). Server-only — the URL itself is a bearer
# secret (anyone with it can read your reservation calendar); never expose it
# to the client or commit a real value to git.
AIRBNB_ICAL_URL=https://www.airbnb.com/calendar/ical/your-listing-id.ics?t=your-token

# HGK (Helsingin Golfklubi) WiseGolf session cookie value for fetching your
# own golf reservations into the Calendar module. Server-only — treat this
# like a password, never commit a real value to git.
#
# How to obtain: log in at app.wisegolf.fi in your browser, open DevTools
# (F12) → Application → Cookies → find "wisenetwork_session", copy its Value.
#
# The cookie is long-lived (WiseGolf sets a multi-year expiry). Refresh only
# if golf reservations stop appearing — e.g. after a manual logout or
# password change on WiseGolf.
wisenetwork_session=
